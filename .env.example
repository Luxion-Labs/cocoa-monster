# Cocoa Monster Environment Configuration
VITE_NETWORK_ID=preview

# Headless factory deployer. Required only when `npm run deploy:factory`
# needs to create a missing factory instead of reusing an existing address.
# COCOA_FACTORY_ENV=local
# COCOA_FACTORY_SEED_HEX=
# COCOA_FACTORY_PRIVATE_STATE_PASSWORD=

# Market discussion (IPFS via Pinata). Optional — omit to disable comments.
# The JWT is embedded client-side (no backend); comment authenticity is
# enforced by signature verification, not by trusting this key. Scope the
# Pinata key to pinning only.
# VITE_PINATA_JWT=
# VITE_PINATA_GATEWAY=your-gateway.mypinata.cloud
# VITE_PINATA_GATEWAY_KEY=
