{
  "name": "cocoa-ui",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-zk-config": "mkdir -p public/keys public/zkir && rm -rf public/keys/* public/zkir/* && cp -r ../contract/src/managed/cocoa/keys/. public/keys/ && cp -r ../contract/src/managed/cocoa/zkir/. public/zkir/ && cp -r ../contract/src/managed/factory/keys/. public/keys/ && cp -r ../contract/src/managed/factory/zkir/. public/zkir/",
    "dev": "npm run sync-zk-config && vite --host 0.0.0.0",
    "predev": "npm run sync-zk-config",
    "build": "npm run sync-zk-config && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "cypress run",
    "e2e:open": "cypress open"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@subframe/core": "^1.154.0",
    "classnames": "^2.5.1",
    "cocoa-contract": "*",
    "copy-to-clipboard": "^4.0.2",
    "events": "^3.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.15.0",
    "rxjs": "^7.8.2",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.1",
    "cypress": "^14.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^2.1.9"
  }
}
