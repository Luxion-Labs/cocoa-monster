{
  "name": "cocoa-ui",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-zk-config": "mkdir -p public && rm -rf public/keys public/zkir && cp -r ../contract/src/managed/cocoa/keys public/keys && cp -r ../contract/src/managed/cocoa/zkir public/zkir",
    "dev": "npm run sync-zk-config && vite --host 0.0.0.0",
    "predev": "npm run sync-zk-config",
    "build": "npm run sync-zk-config && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "cypress run",
    "e2e:open": "cypress open"
  },
  "dependencies": {
    "cocoa-contract": "*",
    "events": "^3.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.15.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.1",
    "cypress": "^14.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^2.1.9"
  }
}
