pragma language_version >= 0.20;

import CompactStandardLibrary;

export enum Side { YES, NO }
export enum Status { OPEN, RESOLVED }

// ----------------- Public market state -----------------
export ledger question: Opaque<"string">;
export ledger closeTime: Uint<64>;

// Public commitment to the oracle's identity. Whoever knows the
// pre-image (`oracleSecret()` witness) is the trusted resolver. Stored
// as `H("cocoa:oracle:" || oracleSecret)` so the secret never appears
// on-chain even at deploy time.
export ledger oraclePubKey: Bytes<32>;

// CPMM reserves. YES probability = reserveNo / (reserveYes + reserveNo).
export ledger reserveYes: Uint<128>;
export ledger reserveNo: Uint<128>;

// Pool of tNIGHT collateral collected from `buy` calls. First buy
// installs the coin; subsequent buys merge into it. Default value is
// zero; the value field doubles as a "have we seen any deposit yet"
// flag (no real bet ever has zero value).
export ledger pool: QualifiedShieldedCoinInfo;

// Lifecycle. With a single trusted signer there is no dispute window —
// a market goes straight from OPEN to RESOLVED when the oracle calls
// `resolve`.
export ledger status: Status;
export ledger outcome: Side;

// Privacy: anonymous position commitments and one-shot redemption nullifiers.
export ledger positions: Set<Bytes<32>>;
export ledger nullifiers: Set<Bytes<32>>;

constructor(
  q: Opaque<"string">,
  initialLiquidity: Uint<128>,
  closeTimestamp: Uint<64>,
  oracleId: Bytes<32>,
) {
  question = disclose(q);
  reserveYes = disclose(initialLiquidity);
  reserveNo = disclose(initialLiquidity);
  closeTime = disclose(closeTimestamp);
  oraclePubKey = disclose(oracleId);
  status = Status.OPEN;
}

// ----------------- Witnesses (private) -----------------
witness localSecretKey(): Bytes<32>;
witness positionNonce(): Bytes<32>;
// The oracle proves they hold this secret in `resolve`. For non-oracle
// callers this returns zero and the assertion in `resolve` rejects.
witness oracleSecret(): Bytes<32>;

// ----------------- Trading -----------------

// Buy `amountOut` outcome shares of `side` for `coin.value` of tNIGHT.
// `amountOut` is computed off-chain from the CPMM invariant against the
// public reserves. Trade size has to be public — the AMM updates on-chain
// reserves by these amounts — but the buyer's identity stays hidden because
// the position commitment mixes their secret + nonce into the hash.
//
// The wallet attaches a shielded tNIGHT coin via the dapp-connector's
// `balanceUnsealedTransaction`. The contract pulls it into its own
// pool, merging with prior collateral so we keep a single coin to pay
// winners out of.
export circuit buy(side: Side, amountOut: Uint<128>, coin: ShieldedCoinInfo): Bytes<32> {
  assert(status == Status.OPEN, "market not open");
  // The caller's coin commitment + nonce flow into the contract's
  // public state via the receive/merge below; disclose the whole
  // ShieldedCoinInfo so the Compact compiler accepts the privacy
  // implications. Coin is already public — buyer signs the tx with
  // it visible to the wallet.
  const publicCoin = disclose(coin);
  assert(publicCoin.color == nativeToken(), "must pay with native NIGHT");
  receiveShielded(publicCoin);

  const publicSide = disclose(side);
  const publicAmount = disclose(amountOut);
  const publicCollateral = publicCoin.value;
  if (publicSide == Side.YES) {
    assert(reserveYes > publicAmount, "insufficient YES liquidity");
    reserveYes = reserveYes - publicAmount;
    reserveNo = (reserveNo + publicCollateral) as Uint<128>;
  } else {
    assert(reserveNo > publicAmount, "insufficient NO liquidity");
    reserveNo = reserveNo - publicAmount;
    reserveYes = (reserveYes + publicCollateral) as Uint<128>;
  }

  // Track collateral as a single contract-held coin. The first buy
  // writes it; subsequent buys merge into it so a later `redeem` can
  // pay winners by splitting one big coin via `sendShielded`.
  const selfRecipient = right<ZswapCoinPublicKey, ContractAddress>(kernel.self());
  if (pool.value == 0) {
    pool.writeCoin(publicCoin, selfRecipient);
  } else {
    pool.writeCoin(mergeCoinImmediate(pool, publicCoin), selfRecipient);
  }

  const sk = localSecretKey();
  const nonce = positionNonce();
  const c = disclose(commitment(sk, nonce, publicSide, publicAmount));
  positions.insert(c);
  return c;
}

// ----------------- Resolution -----------------

// Trusted oracle resolves the market in a single step. The circuit
// recomputes `H("cocoa:oracle:" || oracleSecret)` from the witness and
// asserts it matches the on-chain `oraclePubKey`. Anyone who is not the
// oracle has no witness for `oracleSecret` and the assertion fails.
export circuit resolve(side: Side, nowTs: Uint<64>): [] {
  assert(status == Status.OPEN, "market not open");
  const publicNow = disclose(nowTs);
  assert(publicNow >= closeTime, "market still open");
  const sk = oracleSecret();
  const expected = disclose(oracleCommitment(sk));
  assert(expected == oraclePubKey, "not the oracle");
  outcome = disclose(side);
  status = Status.RESOLVED;
}

// Privately redeem a winning position for tNIGHT. The user proves
// ownership of an existing commitment without revealing their identity
// (no per-user indexing on chain), then publishes a one-shot nullifier
// so they can't redeem the same position twice. Each winning share
// pays 1 atomic NIGHT out of the pool that was funded by buyers.
export circuit redeem(side: Side, amountOut: Uint<128>): Uint<128> {
  assert(status == Status.RESOLVED, "market not resolved");
  const publicSide = disclose(side);
  const publicAmount = disclose(amountOut);
  assert(outcome == publicSide, "wrong side");

  // Verify the caller actually holds this position before checking
  // the pool balance — otherwise the error message ("insufficient
  // pool") leaks treasury state to a non-holder.
  const sk = localSecretKey();
  const nonce = positionNonce();
  const c = disclose(commitment(sk, nonce, publicSide, publicAmount));
  assert(positions.member(c), "no such position");
  const n = disclose(nullifier(sk, nonce, publicSide, publicAmount));
  assert(!nullifiers.member(n), "already redeemed");
  nullifiers.insert(n);

  assert(pool.value >= publicAmount, "insufficient pool");

  // Pay the caller from the pool. sendShielded auto-creates a change
  // output back to the contract; we re-bind `pool` to the change so
  // future redemptions can keep drawing from the same pool.
  const result = sendShielded(
    pool,
    left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey()),
    publicAmount,
  );
  // result.change is Maybe<ShieldedCoinInfo>: Some(remainder) when
  // we partially drain, None when we send the entire pool. We only
  // re-bind on Some — fully draining is acceptable (later redeems
  // will hit the `pool.value >= publicAmount` assertion above).
  if (result.change.is_some) {
    pool.writeCoin(
      result.change.value,
      right<ZswapCoinPublicKey, ContractAddress>(kernel.self()),
    );
  }

  return publicAmount;
}

// ----------------- Helpers -----------------
// Internal — take sk + nonce as parameters so callers stay in charge of
// when witness values get hashed and disclosed.

circuit commitment(sk: Bytes<32>, nonce: Bytes<32>, side: Side, amount: Uint<128>): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "cocoa:pos:"),
    sk,
    nonce,
    amount as Field as Bytes<32>,
    side as Field as Bytes<32>,
  ]);
}

circuit nullifier(sk: Bytes<32>, nonce: Bytes<32>, side: Side, amount: Uint<128>): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "cocoa:null:"),
    sk,
    nonce,
    amount as Field as Bytes<32>,
    side as Field as Bytes<32>,
  ]);
}

// Public commitment to an oracle secret.  `H("cocoa:oracle:" || sk)`.
circuit oracleCommitment(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "cocoa:oracle:"),
    sk,
  ]);
}
