pragma language_version >= 0.20;

import CompactStandardLibrary;

export enum Side { YES, NO }
export enum Status { OPEN, CLOSED, RESOLVED }

// ----------------- Public market state -----------------
export ledger question: Opaque<"string">;
export ledger closeTime: Uint<64>;

// Public commitment to the oracle's identity. Whoever knows the
// pre-image (`oracleSecret()` witness) is the trusted resolver. Stored
// as `H("cocoa:oracle:" || oracleSecret)` so the secret never appears
// on-chain even at deploy time.
export ledger oraclePubKey: Bytes<32>;

// CPMM reserves. YES probability = reserveNo / (reserveYes + reserveNo).
export ledger reserveYes: Uint<64>;
export ledger reserveNo: Uint<64>;

// Contract-held public NIGHT collateral. Every accepted bet receives
// unshielded native NIGHT into this pool before a position is recorded.
export ledger pool: Uint<64>;
export ledger volume: Uint<64>;

// Lifecycle. Markets trade while OPEN, stop accepting buys when CLOSED,
// and pay winning positions after the oracle moves them to RESOLVED.
export ledger status: Status;
export ledger outcome: Side;

// Privacy: anonymous position commitments and one-shot redemption nullifiers.
export ledger positions: Set<Bytes<32>>;
export ledger nullifiers: Set<Bytes<32>>;

constructor(
  q: Opaque<"string">,
  initialLiquidity: Uint<64>,
  closeTimestamp: Uint<64>,
  oracleId: Bytes<32>,
) {
  question = disclose(q);
  reserveYes = disclose(initialLiquidity);
  reserveNo = disclose(initialLiquidity);
  closeTime = disclose(closeTimestamp);
  oraclePubKey = disclose(oracleId);
  status = Status.OPEN;
}

// ----------------- Witnesses (private) -----------------
witness localSecretKey(): Bytes<32>;
witness positionNonce(): Bytes<32>;
// The oracle proves they hold this secret in `resolve`. For non-oracle
// callers this returns zero and the assertion in `resolve` rejects.
witness oracleSecret(): Bytes<32>;

// ----------------- Trading -----------------

// Buy outcome exposure of `side` with real unshielded NIGHT. `amountOut` is
// the UI's CPMM quote used to update visible odds; the redeemable position
// amount is the actual NIGHT stake paid into the contract pool.
export circuit buy(side: Side, amountOut: Uint<64>, stakeAmount: Uint<64>, nowTs: Uint<64>): Uint<64> {
  assert(status == Status.OPEN, "market not open");
  const publicNow = disclose(nowTs);
  assert(publicNow < closeTime, "market closed");
  const publicStake = disclose(stakeAmount);
  const publicAmount = disclose(amountOut);
  assert(publicStake > 0, "stake must be positive");
  assert(publicAmount > 0, "amount must be positive");
  const publicSide = disclose(side);
  const k = reserveYes * reserveNo;
  const sk = localSecretKey();
  const nonce = positionNonce();
  if (publicSide == Side.YES) {
    const newReserveNo = (reserveNo + publicStake) as Uint<64>;
    assert(reserveYes > publicAmount, "insufficient YES liquidity");
    const newReserveYes = reserveYes - publicAmount;
    assert(newReserveYes * newReserveNo >= k, "amount exceeds CPMM quote");
    reserveYes = reserveYes - publicAmount;
    reserveNo = newReserveNo;
    receiveStake(publicStake);
    const c = disclose(commitment(sk, nonce, publicSide, publicStake));
    positions.insert(c);
    return publicStake;
  } else {
    const newReserveYes = (reserveYes + publicStake) as Uint<64>;
    assert(reserveNo > publicAmount, "insufficient NO liquidity");
    const newReserveNo = reserveNo - publicAmount;
    assert(newReserveYes * newReserveNo >= k, "amount exceeds CPMM quote");
    reserveNo = reserveNo - publicAmount;
    reserveYes = newReserveYes;
    receiveStake(publicStake);
    const c = disclose(commitment(sk, nonce, publicSide, publicStake));
    positions.insert(c);
    return publicStake;
  }
}

// ----------------- Resolution -----------------

// Anyone can close the market after `closeTime`. This makes the end of
// trading explicit on-chain before the optimistic oracle finalizes.
export circuit close(nowTs: Uint<64>): [] {
  assert(status == Status.OPEN, "market not open");
  const publicNow = disclose(nowTs);
  assert(publicNow >= closeTime, "market still open");
  status = Status.CLOSED;
}

// Trusted oracle resolves the market in a single step. The circuit
// recomputes `H("cocoa:oracle:" || oracleSecret)` from the witness and
// asserts it matches the on-chain `oraclePubKey`. Anyone who is not the
// oracle has no witness for `oracleSecret` and the assertion fails.
export circuit resolve(side: Side, nowTs: Uint<64>): [] {
  assert(status == Status.CLOSED, "market not closed");
  const publicNow = disclose(nowTs);
  const sk = oracleSecret();
  const expected = disclose(oracleCommitment(sk));
  assert(expected == oraclePubKey, "not the oracle");
  outcome = disclose(side);
  status = Status.RESOLVED;
}

// Privately claim a winning position. The user proves
// ownership of an existing commitment without revealing their identity
// (no per-user indexing on chain), then publishes a one-shot nullifier
// so they can't claim the same position twice. The payout is the stake
// amount committed in `buy`, capped by the contract-held NIGHT pool.
export circuit redeem(side: Side, stakeAmount: Uint<64>, recipient: UserAddress): Uint<64> {
  assert(status == Status.RESOLVED, "market not resolved");
  const publicSide = disclose(side);
  const publicAmount = disclose(stakeAmount);
  assert(outcome == publicSide, "wrong side");

  // Verify the caller actually holds this position before publishing
  // the nullifier, so non-holders cannot mark arbitrary claims spent.
  const sk = localSecretKey();
  const nonce = positionNonce();
  const c = disclose(commitment(sk, nonce, publicSide, publicAmount));
  assert(positions.member(c), "no such position");
  const n = disclose(nullifier(sk, nonce, publicSide, publicAmount));
  assert(!nullifiers.member(n), "already redeemed");
  nullifiers.insert(n);
  assert(pool >= publicAmount, "insufficient pool");
  pool = pool - publicAmount;
  sendUnshielded(
    nativeToken(),
    publicAmount as Uint<128>,
    right<ContractAddress, UserAddress>(disclose(recipient)),
  );
  return publicAmount;
}

// ----------------- Helpers -----------------
// Internal — take sk + nonce as parameters so callers stay in charge of
// when witness values get hashed and disclosed.

circuit commitment(sk: Bytes<32>, nonce: Bytes<32>, side: Side, amount: Uint<64>): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "cocoa:pos:"),
    sk,
    nonce,
    amount as Field as Bytes<32>,
    side as Field as Bytes<32>,
  ]);
}

circuit nullifier(sk: Bytes<32>, nonce: Bytes<32>, side: Side, amount: Uint<64>): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "cocoa:null:"),
    sk,
    nonce,
    amount as Field as Bytes<32>,
    side as Field as Bytes<32>,
  ]);
}

circuit receiveStake(stake: Uint<64>): [] {
  receiveUnshielded(nativeToken(), stake as Uint<128>);
  pool = (pool + stake) as Uint<64>;
  volume = (volume + stake) as Uint<64>;
}

// Public commitment to an oracle secret.  `H("cocoa:oracle:" || sk)`.
circuit oracleCommitment(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "cocoa:oracle:"),
    sk,
  ]);
}
